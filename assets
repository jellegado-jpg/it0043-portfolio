
# 1. Navigate to your folder
cd path/to/it0043-portfolio

# 2. Configure identity (use your own name and email)
git config --global user.name "Your Name"
git config --global user.email "your.email@example.com"

# 3. Initialize Git
git init

# 4. Stage all created files
git add .

# 5. Make your initial commit
git commit -m "Initial commit: setting up portfolio structure"

# 6. Ensure default branch is set to main
git branch -M main

# 7. Link your local repo to GitHub (replace with your actual GitHub username)
git remote add origin https://github.com/YOUR-USERNAME/it0043-portfolio.git

# 8. Push to GitHub
git push -u origin main
